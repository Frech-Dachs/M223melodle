<h1>Hallo <%= current_user.display_name %></h1>

<h2>Meine Gruppen</h2>
<% if @memberships.any? %>
  <ul class="cards">
    <% @memberships.each do |membership| %>
      <li>
        <%= link_to membership.group.name, membership.group %>
        <%= tag.span("HOST", class: "badge") if membership.host? %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Du bist noch in keiner Gruppe.</p>
<% end %>

<div class="actions">
  <%= link_to "Gruppe erstellen", new_group_path %>
  <%= link_to "Gruppe beitreten", new_join_path %>
</div>
