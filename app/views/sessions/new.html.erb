<h1>Anmelden</h1>

<%= form_with url: session_path do |f| %>
  <p><%= f.label :email, "E-Mail" %><br><%= f.email_field :email, value: params[:email] %></p>
  <p><%= f.label :password, "Passwort" %><br><%= f.password_field :password %></p>
  <%= f.submit "Anmelden" %>
<% end %>

<p>Noch kein Konto? <%= link_to "Registrieren", new_user_path %></p>
