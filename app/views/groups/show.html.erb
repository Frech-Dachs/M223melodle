<h1><%= @group.name %></h1>

<p>Einladungscode: <strong><%= @group.invite_code %></strong> (<%= @memberships.size %> / <%= @group.member_limit %> Mitglieder)</p>

<% if @active_round %>
  <p <%= tag.attributes(data: { controller: "auto-visit", auto_visit_url_value: round_path(@active_round) }) if @active_round.started_at > 5.seconds.ago %>>
    <strong>Es läuft eine Runde!</strong> <%= link_to "Jetzt mitspielen", round_path(@active_round) %>
  </p>
<% end %>

<h2>Mitglieder</h2>
<table>
  <thead><tr><th>Name</th><th>Rolle</th><th></th></tr></thead>
  <tbody>
    <% @memberships.each do |membership| %>
      <tr>
        <td><%= membership.user.display_name %></td>
        <td><%= membership.host? ? "Host" : "Spieler" %></td>
        <td>
          <% if policy(membership).destroy? %>
            <%= button_to "Entfernen", group_membership_path(@group, membership), method: :delete,
                  form: { data: { turbo_confirm: "#{membership.user.display_name} wirklich entfernen?" } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to "Aktivitäten", group_activities_path(@group) %> · <%= link_to "Bestenliste", group_leaderboard_path(@group) %> · <%= link_to "Songliste (#{@group.songs.count})", group_songs_path(@group) %></p>

<p><%= link_to "Zurück zum Dashboard", dashboard_path %></p>
