<h1>Registrieren</h1>

<%= form_with model: @user do |f| %>
  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>

  <p><%= f.label :display_name, "Anzeigename" %><br><%= f.text_field :display_name %></p>
  <p><%= f.label :email, "E-Mail" %><br><%= f.email_field :email %></p>
  <p><%= f.label :password, "Passwort (mind. 12 Zeichen)" %><br><%= f.password_field :password %></p>
  <p><%= f.label :password_confirmation, "Passwort bestätigen" %><br><%= f.password_field :password_confirmation %></p>
  <%= f.submit "Registrieren" %>
<% end %>

<p>Schon ein Konto? <%= link_to "Anmelden", new_session_path %></p>
