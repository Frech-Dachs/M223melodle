<h1>Profil bearbeiten</h1>

<%= form_with model: @user, url: profile_path, method: :patch do |f| %>
  <% if @user.errors.any? %>
    <ul>
      <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  <% end %>

  <p><%= f.label :display_name, "Anzeigename" %><br><%= f.text_field :display_name %></p>
  <p>
    <%= f.label :email, "E-Mail (Änderung muss per Link bestätigt werden)" %><br>
    <%= f.email_field :email, value: params.dig(:user, :email) || @user.email %>
  </p>
  <%= f.submit "Speichern" %>
<% end %>

<p><%= link_to "Abbrechen", profile_path %></p>
